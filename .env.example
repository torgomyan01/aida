# RentProg API Configuration
# Add your company token from RentProg company profile
RENTPROG_COMPANY_TOKEN=your_company_token_here

# Avito API — отзывы на главной (Ratings API, OAuth2 client_credentials)
# Получить: https://www.avito.ru/professionals/api — Рейтинги и отзывы
AVITO_CLIENT_ID=your_avito_client_id
AVITO_CLIENT_SECRET=your_avito_client_secret

# Landing "Book demo" → Telegram: token/chat ids in src/config/book-demo-telegram.ts (constants).
# Optional: outbound proxy / alternate API origin if api.telegram.org is unreachable from this host:
# TELEGRAM_HTTPS_PROXY=http://user:pass@your-proxy-host:3128
# TELEGRAM_HTTP_PROXY=...
# TELEGRAM_API_ORIGIN=https://api.telegram.org
